file {
  name: "root.proto"
  package: "p"
  syntax: "proto3"
  enum_type {
    name: "E"
    value { name: "ZERO" number: 0 }
    value { name: "ONE" number: 1 }
  }
  message_type {
    name: "MapHolder"
    nested_type {
      name: "ItemsEntry"
      options { map_entry: true }
      field { name: "key" number: 1 label: LABEL_OPTIONAL type: TYPE_ENUM type_name: ".p.E" }
      field { name: "value" number: 2 label: LABEL_OPTIONAL type: TYPE_INT32 }
    }
    field { name: "items" number: 1 label: LABEL_REPEATED type: TYPE_MESSAGE type_name: ".p.MapHolder.ItemsEntry" }
  }
}
