file {
  name: "dep.proto"
  package: "p"
  syntax: "proto3"
  message_type { name: "D" }
}
file {
  name: "mid.proto"
  package: "p"
  syntax: "proto3"
  dependency: "dep.proto"
}
file {
  name: "root.proto"
  package: "p"
  syntax: "proto3"
  dependency: "dep.proto"
  dependency: "mid.proto"
  enum_type {
    name: "E"
    value { name: "ZERO" number: 0 }
    value { name: "ONE" number: 1 }
  }
  message_type {
    name: "M"
    oneof_decl { name: "pick" }
    field { name: "d" number: 1 label: LABEL_OPTIONAL type: TYPE_MESSAGE type_name: ".p.D" }
    field { name: "e" number: 2 label: LABEL_OPTIONAL type: TYPE_ENUM type_name: ".p.E" oneof_index: 0 }
  }
}
