# U-58: `DescriptorProto.ReservedRange.start` is a varint field, but this
# descriptor writes it as FIXED32. protoc routes the field to the unknown
# fields, so the range disappears and the schema fails on the remaining
# numbers; a decoder that converts the bytes instead accepts the set and
# silently drops the range. The generator turns the start's varint into the
# four-byte fixed-width spelling without changing the total length, so every
# enclosing length prefix stays correct.
file {
  name: "descriptor-wire-fixed32.proto"
  package: "validity"
  syntax: "proto2"
  message_type {
    name: "M"
    field {
      name: "a"
      number: 1
      label: LABEL_OPTIONAL
      type: TYPE_INT32
    }
    reserved_range {
      start: 2097152
      end: 2097153
    }
  }
}
