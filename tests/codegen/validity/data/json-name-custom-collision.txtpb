# W-43: two custom JSON names collide in both syntaxes.
file {
  name: "json-name-custom-collision.proto"
  syntax: "proto3"
  message_type {
    name: "JsonCustomCollision"
    field {
      name: "a"
      number: 1
      label: LABEL_OPTIONAL
      type: TYPE_INT32
      json_name: "same"
    }
    field {
      name: "b"
      number: 2
      label: LABEL_OPTIONAL
      type: TYPE_INT32
      json_name: "same"
    }
  }
}
