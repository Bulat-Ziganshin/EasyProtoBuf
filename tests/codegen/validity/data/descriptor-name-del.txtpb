# A descriptor whose logical file name carries DEL (0x7F). The control-character
# class must include DEL as well as the C0 bytes: DEL is a control character in
# the logical-path rule, and a name this class misses would reach the
# "// Source:" line of the generated header (V-35).
file {
  name: "name\x7fwith-del.proto"
  syntax: "proto2"
  message_type {
    name: "M"
    field { name: "a" number: 1 label: LABEL_OPTIONAL type: TYPE_INT32 }
  }
}
