# A descriptor whose field carries a label outside the three enumerators
# descriptor.proto declares. protoc's decoder routes an unknown Label value to
# the unknown fields and the field keeps its LABEL_OPTIONAL default; this
# project refuses the value at ingestion (V-42). The text format cannot spell
# 99, so `make_descriptors.py` encodes this fixture with LABEL_OPTIONAL and
# LABEL_REQUIRED and writes 99 into the one byte they disagree on.
file {
  name: "label-unknown.proto"
  syntax: "proto2"
  message_type {
    name: "M"
    field { name: "a" number: 1 label: LABEL_OPTIONAL type: TYPE_INT32 }
  }
}
