# W-43: two default JSON names fold to fooBar in proto2; this is a warning
# and generation continues.
file {
  name: "json-name-proto2-warning.proto"
  syntax: "proto2"
  message_type {
    name: "JsonProto2Warning"
    field { name: "foo_bar" number: 1 label: LABEL_OPTIONAL type: TYPE_INT32 }
    field { name: "fooBar" number: 2 label: LABEL_OPTIONAL type: TYPE_INT32 }
  }
}
