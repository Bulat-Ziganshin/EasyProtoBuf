set(s4 "${WORK_DIR}/s4")
file(MAKE_DIRECTORY "${s4}")

# --- W-20: an unknown or misspelled option is refused -----------------------

if(FULL_BUILD)
    foreach(unknown --nope -Z --no-has-field)
        string(MAKE_C_IDENTIFIER "${unknown}" unknown_id)
        run_fail(w20_${unknown_id}_out w20_${unknown_id}_err
