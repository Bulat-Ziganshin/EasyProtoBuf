function(run_ok output_var error_var)
    execute_process(
        COMMAND ${ARGN}
        RESULT_VARIABLE result
        OUTPUT_VARIABLE output
        ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR
            "Command failed (${result}): ${ARGN}\nstdout:\n${output}\nstderr:\n${error}")
    endif()
    set(${output_var} "${output}" PARENT_SCOPE)
    set(${error_var} "${error}" PARENT_SCOPE)
endfunction()

function(run_fail output_var error_var)
    execute_process(
        COMMAND ${ARGN}
        RESULT_VARIABLE result
        OUTPUT_VARIABLE output
        ERROR_VARIABLE error)
    if(result EQUAL 0)
        message(FATAL_ERROR
            "Command unexpectedly succeeded: ${ARGN}\nstdout:\n${output}\nstderr:\n${error}")
    endif()
    set(${output_var} "${output}" PARENT_SCOPE)
    set(${error_var} "${error}" PARENT_SCOPE)
endfunction()

function(require_contains variable_name expected description)
    string(FIND "${${variable_name}}" "${expected}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "${description}: missing '${expected}' in ${variable_name}")
    endif()
endfunction()

function(require_empty variable_name description)
    if(NOT "${${variable_name}}" STREQUAL "")
        message(FATAL_ERROR "${description}: expected empty output, got '${${variable_name}}'")
    endif()
endfunction()

function(require_not_contains variable_name unexpected description)
    string(FIND "${${variable_name}}" "${unexpected}" position)
    if(NOT position EQUAL -1)
        message(FATAL_ERROR "${description}: unexpected '${unexpected}' in ${variable_name}")
    endif()
endfunction()

# Plan 5's CLI contract, exercised through the built executable. The P-group
# invariants are staged with file-tree snapshots: P1 (a failure before
# publication leaves preexisting outputs byte-unchanged), P8 (an output root
# that cannot be created is an error, not an empty success) and P9 (only
# selected targets are published). P2's injected mid-write failure and
# P4-P7's path/identity matrix live in codegen.imports.output, where a failure
# can be staged portably at the publisher boundary.
file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")

