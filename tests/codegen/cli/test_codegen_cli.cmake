# --- CR-40: the component that blocks the output path is named --------------

# A regular file at the first component of the requested output root: the
# diagnostic must name that file, not claim the requested path is one.
set(b10_root_blocker "${b10}/root-blocker.bin")
file(WRITE "${b10_root_blocker}" "I AM A FILE")
run_fail(b10_root_blocker_out b10_root_blocker_err
    ${CODEGEN} --descriptor-set
            --out-dir "${b10_root_blocker}/a/b"
            "${FIXTURE_DIR}/legacy.protodevel.pbs")
require_empty(b10_root_blocker_out "CR-40 root blocker stdout")
require_contains(b10_root_blocker_err
    "${b10_root_blocker}: output path is an existing file, not a directory"
    "CR-40 the blocking component is the diagnostic label")
require_not_contains(b10_root_blocker_err
    "${b10_root_blocker}/a/b: output path is an existing file"
    "CR-40 the requested path is not called a file")

# The control: when the requested root itself is the file, the caller's own
# spelling stays the label (relative here, as typed).
run_fail_in("${b10}" b10_direct_blocker_out b10_direct_blocker_err
    ${CODEGEN} --descriptor-set --out-dir root-blocker.bin
            "${FIXTURE_DIR}/legacy.protodevel.pbs")
require_empty(b10_direct_blocker_out "CR-40 direct blocker stdout")
require_contains(b10_direct_blocker_err
    "root-blocker.bin: output path is an existing file, not a directory"
    "CR-40 a direct blocker keeps the requested spelling")
require_not_contains(b10_direct_blocker_err
    "root-blocker.bin: root-blocker.bin: "
    "CR-40 the direct blocker names the path once")

# The publisher's second directory call: the output root exists, and a
# component below it - the parent of the mapped header - is a file. The
# descriptor path names api/x.proto, so the header lands at api/x.pb.hpp.
set(b10_parent_out "${b10}/parent-block")
file(MAKE_DIRECTORY "${b10_parent_out}")
file(WRITE "${b10_parent_out}/api" "I AM A FILE")
run_fail(b10_parent_blocker_out b10_parent_blocker_err
    ${CODEGEN} --descriptor-set --target api/x.proto
            --out-dir "${b10_parent_out}" "${FIXTURE_DIR}/casepair.pbs")
require_empty(b10_parent_blocker_out "CR-40 parent blocker stdout")
require_contains(b10_parent_blocker_err
    "${b10_parent_out}/api: output path is an existing file, not a directory"
    "CR-40 the blocking parent component is named")

if(FULL_BUILD)
    # The source half: the same blocker, reached through a source logical
    # name and the publisher's parent creation.
    set(b10_src_root "${b10}/src-root")
    file(MAKE_DIRECTORY "${b10_src_root}/sub")
    file(WRITE "${b10_src_root}/sub/probe.proto"
        "syntax = \"proto3\";\nmessage Probe { int32 a = 1; }\n")
    set(b10_src_out "${b10}/src-out")
    file(MAKE_DIRECTORY "${b10_src_out}")
    file(WRITE "${b10_src_out}/sub" "I AM A FILE")
    run_fail(b10_src_blocker_out b10_src_blocker_err
        ${CODEGEN} -I "${b10_src_root}" --out-dir "${b10_src_out}"
                sub/probe.proto)
    require_empty(b10_src_blocker_out "CR-40 source blocker stdout")
    require_contains(b10_src_blocker_err
        "${b10_src_out}/sub: output path is an existing file, not a directory"
        "CR-40 the source path names the blocking component")
endif()

# --- CR-41: a trailing separator on an input is refused ---------------------

# The refusal is at the command line, before any mode reads the spelling, so
# every mode answers the same sentence: a success here would mean the OS
# spelling was normalized back to the file.
function(b10_require_trailing_refusal label workdir spelling)
    execute_process(
        COMMAND ${CODEGEN} ${ARGN}
        WORKING_DIRECTORY "${workdir}"
        RESULT_VARIABLE b10_result
        OUTPUT_VARIABLE b10_out
        ERROR_VARIABLE b10_err)
    if(b10_result EQUAL 0)
        message(FATAL_ERROR
            "CR-41 ${label}: the trailing separator was accepted\nstdout:\n${b10_out}")
    endif()
    if(NOT "${b10_out}" STREQUAL "")
        message(FATAL_ERROR
            "CR-41 ${label}: a refusal must leave stdout empty, got:\n${b10_out}")
    endif()
    string(FIND "${b10_err}"
        "${spelling}: input file name must not end with a path separator"
        b10_position)
    if(b10_position EQUAL -1)
        message(FATAL_ERROR
            "CR-41 ${label}: the diagnostic does not name the spelling and the rule:\n${b10_err}")
    endif()
    string(REGEX MATCHALL "\n" b10_lines "${b10_err}")
    list(LENGTH b10_lines b10_count)
    if(NOT b10_count EQUAL 1)
        message(FATAL_ERROR
            "CR-41 ${label}: expected one diagnostic line, got:\n${b10_err}")
    endif()
endfunction()

b10_require_trailing_refusal("descriptor" "${b10}"
    "${FIXTURE_DIR}/legacy.protodevel.pbs/"
    --descriptor-set "${FIXTURE_DIR}/legacy.protodevel.pbs/")

if(FULL_BUILD)
    b10_require_trailing_refusal("source" "${b10}" "cwd.proto/"
        cwd.proto/)
    b10_require_trailing_refusal("print" "${b10}" "cwd.proto/"
        --print-descriptor cwd.proto/)
    b10_require_trailing_refusal("benchmark" "${b10}" "cwd.proto/"
        --benchmark-parser cwd.proto/)

    # A search root is a directory spelling; a trailing separator there is
    # path syntax, not an input name, and stays accepted.
    run_ok_in("${b10}" b10_root_trailing_out b10_root_trailing_err
        ${CODEGEN} -I "${b10}/" cwd.proto)
    require_contains(b10_root_trailing_out "struct FromCwd"
        "CR-41 a trailing separator on -I is still a directory spelling")

    if(WIN32)
        b10_require_trailing_refusal("source backslash" "${b10}" "cwd.proto\\"
            "cwd.proto\\")
    endif()
endif()

# --- CR-47: the benchmark exits 1 and prints the read reason ----------------

if(FULL_BUILD)
    foreach(b10_bench_kind missing directory)
        if(b10_bench_kind STREQUAL "missing")
            set(b10_bench_input "${b10}/missing-benchmark.proto")
            set(b10_bench_expected "cannot read file")
        else()
            set(b10_bench_input "${b10}/a-directory")
            set(b10_bench_expected "is a directory, not a schema file")
        endif()
        execute_process(
            COMMAND ${CODEGEN} --benchmark-parser "${b10_bench_input}"
            RESULT_VARIABLE b10_bench_result
            OUTPUT_VARIABLE b10_bench_out
            ERROR_VARIABLE b10_bench_err)
        # One exit code for every CLI failure: the benchmark used to answer 2.
        if(NOT b10_bench_result EQUAL 1)
            message(FATAL_ERROR
                "CR-47 ${b10_bench_kind}: expected exit 1, got ${b10_bench_result}\nstderr:\n${b10_bench_err}")
        endif()
        if(NOT "${b10_bench_out}" STREQUAL "")
            message(FATAL_ERROR
                "CR-47 ${b10_bench_kind}: stdout must stay empty, got:\n${b10_bench_out}")
        endif()
        string(FIND "${b10_bench_err}" "${b10_bench_expected}"
            b10_bench_position)
        if(b10_bench_position EQUAL -1)
            message(FATAL_ERROR
                "CR-47 ${b10_bench_kind}: the read reason is missing:\n${b10_bench_err}")
        endif()
        string(REGEX MATCHALL "\n" b10_bench_lines "${b10_bench_err}")
        list(LENGTH b10_bench_lines b10_bench_count)
        if(NOT b10_bench_count EQUAL 1)
            message(FATAL_ERROR
                "CR-47 ${b10_bench_kind}: expected one diagnostic line, got:\n${b10_bench_err}")
        endif()
    endforeach()
endif()

# --- R12: input paths, duplicates and roots (U-19, U-28, U-59, U-60) --------
#
# Row                          codegen after R12                   protoc 30.1
# duplicate positional         one header, rc 0                    rc 0 for --descriptor_set_out;
#                                                                  "Tried to write the same file
#                                                                  twice" for a code output
# print duplicate              byte-identical to one input         no print mode
# absolute input, no -I        the reference sentence, rc 1        "File does not reside within ..."
# absolute input, explicit -I  rc 0                                rc 0
# directory equal to a root    "is a directory, not a schema file" "Input file is a directory."
# drive-relative -I C:foo      refusal naming the rule             "Could not make proto path relative"
#
# U-19 is the owner-decided divergence (variant B): repeated positional inputs
# stay a silent CLI convenience, so the row pins the acceptance and the aligned
# print mode instead of protoc's refusal.

# The descriptor door shares the input list, so it deduplicates identically:
# two identical containers produce one header and one printed tree.
run_ok(r12_pbs_dup_out r12_pbs_dup_err
    ${CODEGEN} --descriptor-set ${single} ${single})
run_ok(r12_pbs_single_out r12_pbs_single_err
    ${CODEGEN} --descriptor-set ${single})
if(NOT r12_pbs_dup_out STREQUAL r12_pbs_single_out)
    message(FATAL_ERROR
        "R12 U-19: a duplicate descriptor input changed the generated header")
endif()
run_ok(r12_pbs_print_dup_out r12_pbs_print_dup_err
    ${CODEGEN} --descriptor-set --print-descriptor ${single} ${single})
run_ok(r12_pbs_print_single_out r12_pbs_print_single_err
    ${CODEGEN} --descriptor-set --print-descriptor ${single})
if(NOT r12_pbs_print_dup_out STREQUAL r12_pbs_print_single_out)
    message(FATAL_ERROR
        "R12 U-19: a duplicate descriptor print is not identical to the single run")
endif()

if(FULL_BUILD)
    set(r12 "${WORK_DIR}/r12")
    file(MAKE_DIRECTORY "${r12}/root")
    file(WRITE "${r12}/a.proto"
        "syntax = \"proto3\";\nmessage DuplicateInput { int32 a = 1; }\n")
    file(WRITE "${r12}/root/a.proto"
        "syntax = \"proto3\";\nmessage RootedInput { int32 a = 1; }\n")

    # U-19: the repeated positional is compiled once and publishes one header.
    file(MAKE_DIRECTORY "${r12}/dup-out")
    run_ok_in("${r12}" r12_dup_out r12_dup_err
        ${CODEGEN} -I . --out-dir dup-out a.proto a.proto)
    require_empty(r12_dup_out "R12 duplicate input stdout")
    require_empty(r12_dup_err "R12 duplicate input stderr")
    file(GLOB r12_dup_files "${r12}/dup-out/*")
    list(LENGTH r12_dup_files r12_dup_count)
    if(NOT r12_dup_count EQUAL 1)
        message(FATAL_ERROR
            "R12 U-19: a repeated input published ${r12_dup_count} files: ${r12_dup_files}")
    endif()
    file(READ "${r12}/dup-out/a.pb.hpp" r12_dup_header)
    require_contains(r12_dup_header "struct DuplicateInput"
        "R12 U-19: the single published header is the input")

    # --print-descriptor follows the same one-input rule: the duplicate run
    # prints exactly what the single-input run prints (no per-file heading).
    run_ok_in("${r12}" r12_print_dup_out r12_print_dup_err
        ${CODEGEN} --print-descriptor a.proto a.proto)
    run_ok_in("${r12}" r12_print_single_out r12_print_single_err
        ${CODEGEN} --print-descriptor a.proto)
    if(NOT r12_print_dup_out STREQUAL r12_print_single_out)
        message(FATAL_ERROR
            "R12 U-19: a duplicate print run is not identical to the single run")
    endif()
    require_contains(r12_print_dup_out "message DuplicateInput"
        "R12 U-19: the print run printed the input")
    require_not_contains(r12_print_dup_out "== a.proto =="
        "R12 U-19: one unique input has no per-file heading")

    # U-59: an absolute input needs an explicit -I root. The file is inside
    # the working directory, so the implicit root would have contained it
    # before the fix; protoc refuses it, and so does codegen now.
    run_fail_in("${r12}" r12_abs_out r12_abs_err
        ${CODEGEN} "${r12}/a.proto")
    require_empty(r12_abs_out "R12 U-59 absolute input without a root stdout")
    require_contains(r12_abs_err
        "File does not reside within any path specified using --proto_path (or -I)"
        "R12 U-59 the refusal uses the reference sentence")
    string(REGEX MATCHALL "\n" r12_abs_lines "${r12_abs_err}")
    list(LENGTH r12_abs_lines r12_abs_count)
    if(NOT r12_abs_count EQUAL 1)
        message(FATAL_ERROR
            "R12 U-59: expected one diagnostic line, got:\n${r12_abs_err}")
    endif()

    # The same absolute spelling loads once a root encompasses it.
    run_ok_in("${r12}" r12_abs_root_out r12_abs_root_err
        ${CODEGEN} -I "${r12}" "${r12}/a.proto")
    require_contains(r12_abs_root_out "struct DuplicateInput"
        "R12 U-59 an absolute input under an explicit root loads")
    require_empty(r12_abs_root_err "R12 U-59 accepted absolute input stderr")

    # U-28: a directory equal to the search root is inside it, so it is
    # reported as a directory rather than as an outsider.
    run_fail_in("${r12}" r12_dir_out r12_dir_err
        ${CODEGEN} -I root root)
    require_empty(r12_dir_out "R12 U-28 root directory stdout")
    require_contains(r12_dir_err "is a directory, not a schema file"
        "R12 U-28 the root directory is a directory")
    require_not_contains(r12_dir_err "outside all search roots"
        "R12 U-28 the root directory is not an outsider")
    run_fail_in("${r12}" r12_dot_out r12_dot_err
        ${CODEGEN} .)
    require_contains(r12_dot_err "is a directory, not a schema file"
        "R12 U-28 the implicit root directory is a directory")

    # U-60: a drive-relative search root is refused. An absolute root and a
    # plain relative root stay accepted: the rows above use a relative root
    # and the absolute-input row uses ${r12}.
    if(WIN32)
        run_fail_in("${r12}" r12_drive_out r12_drive_err
            ${CODEGEN} -I "C:foo" a.proto)
        require_empty(r12_drive_out "R12 U-60 drive-relative root stdout")
        require_contains(r12_drive_err "drive-relative spelling is not a search root"
            "R12 U-60 the refusal names the rule")
        run_fail_in("${r12}" r12_bare_drive_out r12_bare_drive_err
            ${CODEGEN} -I "C:" a.proto)
        require_contains(r12_bare_drive_err "drive-relative spelling is not a search root"
            "R12 U-60 a bare drive is the same form")
    endif()
endif()
