if(NOT DEFINED CODEGEN)
    message(FATAL_ERROR "CODEGEN is required")
endif()
if(NOT DEFINED DATA_DIR)
    message(FATAL_ERROR "DATA_DIR is required")
endif()
if(NOT DEFINED WORK_DIR)
    message(FATAL_ERROR "WORK_DIR is required")
endif()
if(NOT DEFINED FULL_BUILD)
    set(FULL_BUILD 1)
endif()

function(run_ok output_var error_var)
    execute_process(
        COMMAND ${ARGN}
        RESULT_VARIABLE result
        OUTPUT_VARIABLE output
        ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR
            "Command failed (${result}): ${ARGN}\nstdout:\n${output}\nstderr:\n${error}")
    endif()
    set(${output_var} "${output}" PARENT_SCOPE)
    set(${error_var} "${error}" PARENT_SCOPE)
endfunction()

function(run_fail output_var error_var)
    execute_process(
        COMMAND ${ARGN}
        RESULT_VARIABLE result
        OUTPUT_VARIABLE output
        ERROR_VARIABLE error)
    if(result EQUAL 0)
        message(FATAL_ERROR
            "Command unexpectedly succeeded: ${ARGN}\nstdout:\n${output}\nstderr:\n${error}")
    endif()
    set(${output_var} "${output}" PARENT_SCOPE)
    set(${error_var} "${error}" PARENT_SCOPE)
endfunction()

function(require_contains variable_name expected description)
    string(FIND "${${variable_name}}" "${expected}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "${description}: missing '${expected}' in ${variable_name}")
    endif()
endfunction()

function(require_empty variable_name description)
    if(NOT "${${variable_name}}" STREQUAL "")
        message(FATAL_ERROR "${description}: expected empty output, got '${${variable_name}}'")
    endif()
endfunction()

# Plan 5's CLI contract, exercised through the built executable. The P-group
# invariants are staged with file-tree snapshots: P1 (a failure before
# publication leaves preexisting outputs byte-unchanged), P8 (an output root
# that cannot be created is an error, not an empty success) and P9 (only
# selected targets are published). P2's injected mid-write failure and
# P4-P7's path/identity matrix live in codegen.imports.output, where a failure
# can be staged portably at the publisher boundary.
file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")

set(single "${DATA_DIR}/integration-proto2.pbs")   # one named file
set(multi "${DATA_DIR}/integration-multi.pbs")     # two named files
set(empty "${DATA_DIR}/empty.pbs")

# Help output keeps the new options visible and still renders.
run_ok(help_out help_err ${CODEGEN} --help)
require_contains(help_out "--target" "Help lists the target option")
require_contains(help_out "--proto_path" "Help lists the proto_path option")
require_contains(help_out "--out-dir" "Help lists the out-dir option")

# --- the mode table ---------------------------------------------------------

# One file, no --target: thin-descriptor compatibility to stdout.
run_ok(single_out single_err ${CODEGEN} --descriptor-set ${single})
require_contains(single_out "Generated by EasyProtoBuf Codegen"
    "Single-file compatibility output")
require_empty(single_err "Single-file compatibility stderr")

# One file, --target: complete linking to stdout.
run_ok(single_target_out single_target_err
    ${CODEGEN} --descriptor-set ${single} --target integration-proto2.proto)
require_contains(single_target_out "// Source: integration-proto2.proto"
    "Single selected target provenance")

# Several files, no --target: guidance error, empty stdout.
run_fail(multi_out multi_err ${CODEGEN} --descriptor-set ${multi})
require_contains(multi_err "--target NAME is required"
    "Multi-file selection guidance")
require_empty(multi_out "Multi-file selection error stdout")

# Several files, one --target: stdout carries the one selected header.
run_ok(multi_one_out multi_one_err
    ${CODEGEN} --descriptor-set ${multi} --target integration-proto3.proto)
require_contains(multi_one_out "// Source: integration-proto3.proto"
    "Selected target provenance")

# Several files, two --targets, no --out-dir: stdout cardinality error.
run_fail(multi_two_out multi_two_err
    ${CODEGEN} --descriptor-set ${multi}
            --target integration-proto2.proto
            --target integration-proto3.proto)
require_contains(multi_two_err "--out-dir" "Several targets need an out-dir")
require_empty(multi_two_out "Several-targets stdout")

# --- publication: dedup, P9, stdout emptiness -------------------------------

set(pub_dir "${WORK_DIR}/pub")
file(MAKE_DIRECTORY "${pub_dir}")
run_ok(pub_out pub_err
    ${CODEGEN} --descriptor-set ${multi}
            --target integration-proto2.proto
            --target integration-proto2.proto
            --out-dir "${pub_dir}")
require_empty(pub_out "Publication must not write stdout")

file(GLOB published "${pub_dir}/*")
list(LENGTH published published_count)
if(NOT published_count EQUAL 1)
    message(FATAL_ERROR
        "Deduplicated selection published ${published_count} files: ${published}")
endif()
get_filename_component(published_name "${published}" NAME)
if(NOT published_name STREQUAL "integration-proto2.pb.hpp")
    message(FATAL_ERROR "Unexpected published name: ${published_name}")
endif()
file(READ "${published}" published_text)
require_contains(published_text "// Source: integration-proto2.proto"
    "Published header content")
if(EXISTS "${pub_dir}/integration-proto3.pb.hpp")
    message(FATAL_ERROR "P9: an unselected target was published")
endif()

# --- P1: a later invalid target publishes nothing ----------------------------

set(p1_dir "${WORK_DIR}/p1")
file(MAKE_DIRECTORY "${p1_dir}")
set(p1_existing "${p1_dir}/integration-proto2.pb.hpp")
file(WRITE "${p1_existing}" "KEEP ME")
run_fail(p1_out p1_err
    ${CODEGEN} --descriptor-set ${multi}
            --target integration-proto2.proto
            --target missing.proto
            --out-dir "${p1_dir}")
require_empty(p1_out "P1 stdout")
require_contains(p1_err "missing.proto" "P1 names the absent target")
file(READ "${p1_existing}" p1_content)
if(NOT p1_content STREQUAL "KEEP ME")
    message(FATAL_ERROR "P1: a preexisting output changed on failure")
endif()

# --- an absent target is named ----------------------------------------------

run_fail(absent_out absent_err
    ${CODEGEN} --descriptor-set ${single} --target nope.proto)
require_contains(absent_err "nope.proto" "Absent target diagnostic")
require_empty(absent_out "Absent target stdout")

# --- P8: an output root that cannot be created ------------------------------

set(file_root "${WORK_DIR}/not-a-directory")
file(WRITE "${file_root}" "I AM A FILE")
run_fail(file_root_out file_root_err
    ${CODEGEN} --descriptor-set ${multi}
            --target integration-proto2.proto
            --out-dir "${file_root}")
require_empty(file_root_out "P8 stdout")
require_contains(file_root_err "not a directory" "P8 diagnostic")

# --- option validation ------------------------------------------------------

run_fail(repeated_out_dir_out repeated_out_dir_err
    ${CODEGEN} --descriptor-set ${single}
            --out-dir "${WORK_DIR}/a" --out-dir "${WORK_DIR}/b")
require_contains(repeated_out_dir_err "--out-dir may be given only once"
    "Repeated --out-dir rejection")

run_fail(empty_out_dir_out empty_out_dir_err
    ${CODEGEN} --descriptor-set ${single} --out-dir=)
require_contains(empty_out_dir_err "requires a non-empty value"
    "Empty --out-dir rejection")

run_fail(descriptor_root_out descriptor_root_err
    ${CODEGEN} --descriptor-set -I "${DATA_DIR}" ${single})
require_contains(descriptor_root_err "-I/--proto_path is valid only with"
    "Descriptor mode rejects -I")

run_fail(empty_container_out empty_container_err
    ${CODEGEN} --descriptor-set ${empty})
require_contains(empty_container_err "contains no FileDescriptorProto"
    "Empty container rejection")
require_empty(empty_container_out "Empty container stdout")

if(FULL_BUILD)
    run_fail(source_target_out source_target_err
        ${CODEGEN} -I "${DATA_DIR}"
                --target integration-proto2.proto
                "${DATA_DIR}/integration-proto2.proto")
    require_contains(source_target_err "--target is valid only with"
        "Source mode rejects --target")

    run_ok(source_stdout source_stdout_err
        ${CODEGEN} -I "${DATA_DIR}" "${DATA_DIR}/integration-proto2.proto")
    require_contains(source_stdout "// Source: integration-proto2.proto"
        "Source target provenance")
else()
    run_fail(lite_source_out lite_source_err
        ${CODEGEN} "${DATA_DIR}/integration-proto2.proto")
    require_contains(lite_source_err "no .proto parser"
        "Lite build source rejection")
endif()
