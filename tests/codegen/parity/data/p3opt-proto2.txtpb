# R05 (U-11): proto3_optional on a field of a proto2 file. The oneof layout is
# well-formed, so only the syntax rule can refuse the shape. protoc 30.1
# refuses it ("The [proto3_optional=true] option may only be set on proto3
# fields").
file {
  name: "p3opt-proto2.proto"
  package: "parity"
  message_type {
    name: "M"
    field {
      name: "f"
      number: 1
      label: LABEL_OPTIONAL
      type: TYPE_INT32
      proto3_optional: true
      oneof_index: 0
    }
    oneof_decl { name: "_f" }
  }
}
