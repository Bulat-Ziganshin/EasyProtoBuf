# R05 (U-11): a synthetic oneof declared before a real oneof. protoc 30.1
# refuses it ("Synthetic oneofs must be after all other oneofs"); the source
# parser appends the synthetic oneofs it creates, so only a crafted descriptor
# can carry the order.
file {
  name: "p3opt-synthetic-first.proto"
  package: "parity"
  syntax: "proto3"
  message_type {
    name: "M"
    field {
      name: "f"
      number: 1
      label: LABEL_OPTIONAL
      type: TYPE_INT32
      proto3_optional: true
      oneof_index: 0
    }
    field {
      name: "g"
      number: 2
      label: LABEL_OPTIONAL
      type: TYPE_INT32
      oneof_index: 1
    }
    oneof_decl { name: "_f" }
    oneof_decl { name: "o" }
  }
}
