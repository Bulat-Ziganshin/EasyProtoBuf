# V-09: an extension member with no extendee. The decoder now reads the member
# and both linking modes refuse it; protoc 30.1 refuses the same bytes
# ("FieldDescriptorProto.extendee not set for extension field.").
file {
  name: "ext-member-no-extendee.proto"
  package: "parity"
  syntax: "proto2"
  message_type {
    name: "N"
    extension {
      name: "e"
      number: 5
      label: LABEL_OPTIONAL
      type: TYPE_INT32
    }
  }
}
