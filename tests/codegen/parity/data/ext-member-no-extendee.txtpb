# CR-25 (accepted, E6): an extension member with no extendee. The model counts
# DescriptorProto.extension and decodes no member, so nothing asks whether the
# extendee is present; protoc 30.1 refuses the bytes
# ("FieldDescriptorProto.extendee not set for extension field.").
file {
  name: "ext-member-no-extendee.proto"
  package: "parity"
  syntax: "proto2"
  message_type {
    name: "N"
    extension {
      name: "e"
      number: 5
      label: LABEL_OPTIONAL
      type: TYPE_INT32
    }
  }
}
