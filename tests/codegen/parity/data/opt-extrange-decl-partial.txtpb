# U-22: a declaration that sets `full_name` but not `type`, and is not a
# `reserved` tombstone. protoc refuses it ("Extension declaration #150 should
# have both \"full_name\" and \"type\" set."); the source door keeps the
# aggregate option body opaque (E13), so this is a descriptor-only refusal.
file {
  name: "opt-extrange-decl-partial.proto"
  package: "opt"
  syntax: "proto2"
  message_type {
    name: "Partial"
    field {
      name: "value"
      number: 1
      label: LABEL_OPTIONAL
      type: TYPE_INT32
    }
    extension_range {
      start: 100
      end: 200
      options {
        declaration { number: 150 full_name: ".opt.ext" }
      }
    }
  }
}
