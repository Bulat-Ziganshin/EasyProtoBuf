# V-07: a declaration full_name without the leading dot. protoc's
# ValidateSymbolForDeclaration (descriptor.cc:8296-8308) refuses it with
# "\"opt.ext\" must have a leading dot to indicate the fully-qualified scope.".
file {
  name: "opt-extrange-decl-name-no-dot.proto"
  package: "opt"
  syntax: "proto2"
  message_type {
    name: "ExtensionTarget"
    extension_range {
      start: 100
      end: 200
      options {
        declaration {
          number: 150
          full_name: "opt.ext"
          type: ".opt.ExtensionTarget"
        }
      }
    }
  }
}
