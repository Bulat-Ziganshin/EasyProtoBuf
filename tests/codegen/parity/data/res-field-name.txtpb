# CR-06, message shape 2: field a uses the reserved name "a".
file {
  name: "res-field-name.proto"
  package: "parity"
  syntax: "proto2"
  message_type {
    name: "M"
    field {
      name: "a"
      number: 1
      label: LABEL_OPTIONAL
      type: TYPE_INT32
    }
    reserved_name: "a"
  }
}
